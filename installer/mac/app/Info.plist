<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Fuorigioco</string>
    <!-- Deve restare uguale al nome del pacchetto sul disco (Contabilita.app): solo cosi' il Finder mostra il nome
         localizzato, "Fuorigioco", preso da Resources/<lingua>.lproj/InfoPlist.strings. -->
    <key>CFBundleDisplayName</key>
    <string>Contabilita</string>
    <key>LSHasLocalizedDisplayName</key>
    <true/>
    <key>CFBundleDevelopmentRegion</key>
    <string>it</string>
    <key>CFBundleIdentifier</key>
    <string>it.contabilita.app</string>
    <key>CFBundleExecutable</key>
    <string>Contabilita</string>
    <key>CFBundleIconFile</key>
    <string>contabilita</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleVersion</key>
    <string>@VERSIONE@</string>
    <key>CFBundleShortVersionString</key>
    <string>@VERSIONE@</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright (C) 2026 Fuorigioco</string>
</dict>
</plist>
